# Supabase configuration.
#
# 1. Copy this file to `.env.local`  (git-ignored, used by `npm run dev`).
# 2. Fill in the values from your Supabase project:
#       Supabase Dashboard -> Project Settings -> API
#    - Project URL            -> VITE_SUPABASE_URL
#    - Project API keys: anon  -> VITE_SUPABASE_ANON_KEY
#
# The anon (public) key is safe to expose in the browser; access is controlled
# by Row Level Security policies (see supabase/migrations/0001_init.sql).
#
# On Netlify, set the same two variables under:
#   Site settings -> Environment variables  (scope: Builds / all)
# so they are inlined at build time.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
